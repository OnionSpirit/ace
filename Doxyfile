# ===========================================================================
#  ACE — Async Concurrent Execution Framework
#  Doxygen configuration
# ===========================================================================

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------
PROJECT_NAME           = "ACE"
PROJECT_BRIEF          = "Async Concurrent Execution — C++23 coroutine-based concurrency framework"
PROJECT_NUMBER         = 0.9.9
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = include \
                         README.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */oldbase/*
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             =

#---------------------------------------------------------------------------
# Extraction — document EVERYTHING
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FORCE_LOCAL_INCLUDES   = NO

#---------------------------------------------------------------------------
# Documentation details
#---------------------------------------------------------------------------
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
# SORT_GROUP_DOCS        = YES  (removed: unsupported in Doxygen 1.16)
ALWAYS_DETAILED_SEC    = YES
REPEAT_BRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
PREDEFINED             = __GNUC__
SKIP_FUNCTION_MACROS   = NO
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Markdown & aliases
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4

# Inject a Mermaid diagram block into HTML output.
# Usage in Doxygen comments:  @mermaid{ graph LR; A-->B }
# Multi-line: use \n literal inside the braces.
ALIASES  = "mermaid{1}=@htmlonly<div class=\"mermaid\">\1</div>@endhtmlonly"
ALIASES += "thread_safety{1}=@par Thread Safety\n\1"
ALIASES += "complexity{1}=@par Complexity\n\1"

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# WARN_RETURN_TYPE       = YES  (removed: unsupported in Doxygen 1.16)
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = docs/doxygen/warnings.log

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = docs/doxygen_header.html
HTML_COLORSTYLE        = LIGHT
# extra stylesheets — doxygen-awesome + Catppuccin theme
HTML_EXTRA_STYLESHEET   = docs/doxygen/doxygen-awesome.css \
                          docs/doxygen/catppuccin.css
# doxygen-awesome JS plugins (dark-mode toggle, copy button, etc.)
HTML_EXTRA_FILES        = docs/doxygen/doxygen-awesome-darkmode-toggle.js \
                          docs/doxygen/doxygen-awesome-fragment-copy-button.js \
                          docs/doxygen/doxygen-awesome-paragraph-link.js \
                          docs/doxygen/doxygen-awesome-interactive-toc.js \
                          docs/doxygen/doxygen-awesome-tabs.js
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 280
EXT_LINKS_IN_WINDOW    = NO
FORMULA_FONTSIZE       = 10
USE_MATHJAX            = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

#---------------------------------------------------------------------------
# LaTeX / PDF (disabled by default — enable for PDF export)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex

#---------------------------------------------------------------------------
# Class / dependency diagrams (Graphviz is unavailable in this environment)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 50
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = NO
DIRECTORY_GRAPH        = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = NO
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Index / groups
#---------------------------------------------------------------------------
ALPHABETICAL_INDEX     = YES
GENERATE_TAGFILE       = docs/doxygen/ace.tag

#---------------------------------------------------------------------------
# Other outputs (disabled)
#---------------------------------------------------------------------------
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO
