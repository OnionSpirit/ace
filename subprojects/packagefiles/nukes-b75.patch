--- /dev/null
+++ b/include/nukes/dynamic/serialized_freelist.h
@@ -0,0 +1,177 @@
+/**
+ * @file
+ * @brief Queue-local concurrent freelist with safe immediate node reuse.
+ */
+#ifndef NUKES_DYNAMIC_SERIALIZED_FREELIST
+#define NUKES_DYNAMIC_SERIALIZED_FREELIST
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <new>
+#include <thread>
+#include <utility>
+
+#include "nukes/details/node_allocation.h"
+#include "nukes/details/node_types.h"
+
+namespace nukes::dynamic::reclamation_detail {
+
+/**
+ * @brief Serializes only freelist metadata transitions for one queue instance.
+ *
+ * @details A node removed from a lock-free freelist cannot be reused while a
+ * competing pop may still hold its address. This implementation uses a short
+ * per-instance gate around the freelist head transition. Payload destruction
+ * and reconstruction happen outside the gate, so re-entrant destructors cannot
+ * deadlock and unrelated queues never contend with each other.
+ *
+ * Stored nodes always contain a live default-constructed payload. This preserves
+ * the roaming node ABI and makes subsequent assignment well-defined after a
+ * previous @c release() destroyed the old payload.
+ *
+ * @tparam dataT Payload stored in each freelist node.
+ */
+template <typename dataT>
+class serialized_freelist {
+protected:
+    using node_t = nukes::detail::nodes::dyn_node<dataT>;
+
+private:
+    alignas(64) node_t* _head {};
+    alignas(64) mutable std::atomic_flag _gate = ATOMIC_FLAG_INIT;
+
+    void lock() const noexcept {
+        while (_gate.test_and_set(std::memory_order_acquire))
+            std::this_thread::yield();
+    }
+
+    void unlock() const noexcept {
+        _gate.clear(std::memory_order_release);
+    }
+
+    [[nodiscard]] static node_t* node_from_data(void* data) noexcept {
+        static const auto data_offset = [] {
+            node_t node {};
+            return reinterpret_cast<std::uintptr_t>(std::addressof(node._data))
+                - reinterpret_cast<std::uintptr_t>(std::addressof(node));
+        }();
+        return reinterpret_cast<node_t*>(
+            static_cast<std::uint8_t*>(data) - data_offset);
+    }
+
+    void recycle(node_t* node) noexcept {
+        lock();
+        node->_next.store(_head, std::memory_order_relaxed);
+        _head = node;
+        unlock();
+    }
+
+    void clear() noexcept {
+        node_t* nodes;
+        lock();
+        nodes = std::exchange(_head, nullptr);
+        unlock();
+
+        while (nodes) {
+            auto* const next = static_cast<node_t*>(
+                nodes->_next.load(std::memory_order_relaxed));
+            std::destroy_at(std::addressof(nodes->_data));
+            nukes::detail::nodes::release_node_storage(nodes);
+            nodes = next;
+        }
+    }
+
+public:
+    serialized_freelist() noexcept = default;
+
+    ~serialized_freelist() noexcept {
+        clear();
+    }
+
+    serialized_freelist(const serialized_freelist&) = delete;
+    serialized_freelist& operator=(const serialized_freelist&) = delete;
+
+    serialized_freelist(serialized_freelist&& other) noexcept {
+        _head = std::exchange(other._head, nullptr);
+    }
+
+    serialized_freelist& operator=(serialized_freelist&& other) noexcept {
+        if (this == std::addressof(other))
+            return *this;
+        clear();
+        _head = std::exchange(other._head, nullptr);
+        return *this;
+    }
+
+    /**
+     * @brief Destroys a payload and returns its reconstructed storage to the pool.
+     * @param data Live payload obtained from @ref capture; cleared on return.
+     * @return @c true on reuse, or @c false if default reconstruction throws.
+     */
+    bool release(dataT*& data) noexcept {
+        if (not data)
+            return false;
+        auto* const node = node_from_data(data);
+        std::destroy_at(data);
+        try {
+            std::construct_at(data);
+        } catch (...) {
+            nukes::detail::nodes::release_node_storage(node);
+            data = nullptr;
+            return false;
+        }
+        data = nullptr;
+        recycle(node);
+        return true;
+    }
+
+    /**
+     * @brief Returns storage whose payload lifetime remains active.
+     * @param data Live payload address obtained from this compatible node ABI.
+     * @return @c true when accepted, @c false for null.
+     */
+    bool raw_release(void* data) noexcept {
+        if (not data)
+            return false;
+        recycle(node_from_data(data));
+        return true;
+    }
+
+    /**
+     * @brief Acquires one live payload, allocating a node when the pool is empty.
+     * @param data Receives the payload address.
+     * @return @c true on success, @c false on allocation failure.
+     */
+    [[nodiscard]] bool capture(dataT*& data) noexcept {
+        lock();
+        auto* node = _head;
+        if (node)
+            _head = static_cast<node_t*>(node->_next.load(std::memory_order_relaxed));
+        unlock();
+
+        if (not node)
+            node = nukes::detail::nodes::make_node<node_t>();
+        if (not node) {
+            data = nullptr;
+            return false;
+        }
+        data = std::addressof(node->_data);
+        return true;
+    }
+
+    /**
+     * @brief Returns an exact synchronized empty snapshot.
+     */
+    [[nodiscard]] bool empty() const noexcept {
+        lock();
+        const bool result = _head == nullptr;
+        unlock();
+        return result;
+    }
+};
+
+} // namespace nukes::dynamic::reclamation_detail
